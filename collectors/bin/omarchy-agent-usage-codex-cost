#!/usr/bin/env python3
"""Run an existing Codex scanner and add its derived local API-rate estimate."""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from agent_usage_collectors.transcript_cost import decorate  # noqa: E402

system_base = Path("/usr/share/omarchy/bin/omarchy-agent-usage-codex")
saved_base = Path.home() / ".local/bin/agent-usage-plus-base-codex"
# The installer preserves a user-owned collector precisely because it can
# carry compatibility fixes ahead of Omarchy's packaged version. Prefer it
# when present (Codex 0.149 no longer accepts the package's `-a untrusted`).
base = os.environ.get("AGENT_USAGE_PLUS_CODEX_BASE_COLLECTOR") or str(saved_base if saved_base.is_file() else system_base)
try:
    result = subprocess.run([base, *sys.argv[1:]], text=True, capture_output=True, check=True, timeout=90)
    record = json.loads(result.stdout)
    if not isinstance(record, dict):
        raise ValueError("base collector did not emit an object")
    print(json.dumps(decorate(record, "codex", "Local transcript history"), separators=(",", ":")))
except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
    print(json.dumps({"id": "codex", "name": "Codex", "ready": False, "usageStatusText": "Codex collector unavailable", "authHelpText": f"Install Codex or set AGENT_USAGE_PLUS_CODEX_BASE_COLLECTOR. ({type(exc).__name__})"}, separators=(",", ":")))
